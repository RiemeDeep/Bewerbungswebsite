# Generate a unique 256-bit value. Do not add the Bearer prefix here.
ORCHESTRATOR_REQUEST_SECRET=replace-me

# Keep disabled until the Paket-5.0 staging gate is explicitly approved.
ENABLE_PROFILE_ASSISTANT_STAGING=0

# Read-only profile runtime role; never use the PostgreSQL owner/admin role.
PROFILE_DATABASE_URL=

# Provider credentials remain server-side in this root-only file.
LLM_API_KEY=
LLM_ASSISTANT_MODEL=gpt-4.1-mini
LLM_REQUEST_TIMEOUT_MS=15000
LLM_REPAIR_ATTEMPTS=1

# Conservative single-instance staging limits.
PROFILE_ASSISTANT_REQUEST_TIMEOUT_MS=18000
PROFILE_ASSISTANT_REQUESTS_PER_MINUTE=5
PROFILE_ASSISTANT_REQUESTS_PER_DAY=50
PROFILE_ASSISTANT_MAX_CONCURRENCY=2

# Short-lived stored match results; allowed range: 1-168 hours.
ANALYSIS_TTL_HOURS=24

# Protected internal JobContext/match runtime. Keep disabled until Paket M2 staging approval.
ENABLE_MATCH_RUNTIME_STAGING=0
# Separate kill switch for the real match assistant. Requires match/profile DB URLs and provider key.
ENABLE_MATCH_ASSISTANT_STAGING=0
MATCH_RUNTIME_REQUEST_TIMEOUT_MS=45000
MATCH_RUNTIME_REQUESTS_PER_MINUTE=10
MATCH_RUNTIME_REQUESTS_PER_DAY=100
MATCH_RUNTIME_MAX_CONCURRENCY=2
