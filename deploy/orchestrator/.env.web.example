# Copy to .env.web on the VPS and keep it root-only (0600).
# These values are server-side only. Never prefix them with NEXT_PUBLIC_.

# Keep disabled unless an internal review session is intended.
ENABLE_INTERNAL_PROFILE_PREVIEW=0

# Keep disabled until the Orchestrator staging runtime and evaluation gate are ready.
ENABLE_INTERNAL_PROFILE_ASSISTANT_STAGING=0
PROFILE_ASSISTANT_BFF_TIMEOUT_MS=18000
MATCH_RUNTIME_BFF_TIMEOUT_MS=55000

# Preview login shown by the browser's Basic Auth prompt.
INTERNAL_PROFILE_PREVIEW_USERNAME=replace-me
INTERNAL_PROFILE_PREVIEW_PASSWORD=replace-me

# Must match the Orchestrator internal request secret.
ORCHESTRATOR_REQUEST_SECRET=replace-me
