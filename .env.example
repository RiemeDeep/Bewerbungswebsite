# Public web configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Michael Flatau

# Internal service routing
ORCHESTRATOR_BASE_URL=http://localhost:4000
ORCHESTRATOR_REQUEST_SECRET=replace-me

# Supabase - keep the service role key server-side
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model provider
LLM_PROVIDER=
LLM_API_KEY=
# Optional local alias; runtime prefers LLM_API_KEY when both are set.
OPENAI_API_KEY=
LLM_ANALYSIS_MODEL=
LLM_ASSISTANT_MODEL=
LLM_EMBEDDING_MODEL=
LLM_REQUEST_TIMEOUT_MS=15000
LLM_REQUEST_RETRIES=1
LLM_REPAIR_ATTEMPTS=1
RUN_PROVIDER_INTEGRATION_TESTS=0

# Synthetic technical test mode - never enable for production traffic
ENABLE_SYNTHETIC_ASSISTANT_TEST=0
NEXT_PUBLIC_ENABLE_SYNTHETIC_ASSISTANT_TEST=0
ENABLE_MATCH_PREVIEW_TEST=0
NEXT_PUBLIC_ENABLE_MATCH_PREVIEW_TEST=0
ENABLE_SYNTHETIC_MATCH_ANALYSIS_TEST=0
MATCH_PREVIEW_MODE=mock

# Crawl service
ENABLE_JOB_CONTEXT_PREVIEW=0
CRAWL_PROVIDER=mock
JOB_CONTEXT_EXTRACTOR=mock
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_STORE_IN_CACHE=0
RUN_CRAWL_PROVIDER_INTEGRATION_TESTS=0

# Application limits
MAX_JOB_TEXT_CHARS=60000
MAX_CHAT_MESSAGE_CHARS=3000
ANALYSIS_TTL_HOURS=24
CHAT_SESSION_TTL_HOURS=24

# Optional internal n8n integration
N8N_INTERNAL_BASE_URL=
N8N_WEBHOOK_SECRET=
